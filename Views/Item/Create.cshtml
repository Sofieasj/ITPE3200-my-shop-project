@model Item
<h2>Create New Item</h2>

<form asp-action="Create">
    <div class="form-group">
        <!-- asp-attribute is a taghjelper in ASP.NET Core that helps model binding and validation
        Associates form input element w/specific property in model class -->
        <label asp-for="Name"></label>
        <span class="text-danger">*</span>
        <input asp-for="Name" class="form-control" />
        <!-- verifies user input against Item Model -->
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <span class="text-danger">*</span>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <span class="text-danger">*</span>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ImageUrl"></label>
        <span class="text-danger">*</span>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Table" class="btn btn-secondary">Back to Table View</a>
</form>