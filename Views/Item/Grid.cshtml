@model ItemsViewModel

<!-- combining static and dynamic title -->
<h1>List of Shop Items (@Model.CurrentViewName View)</h1>
<a href="/Item/Table">Table View</a>

<!-- creates dynamically scaling grid -->
<section class="row row-cols-1 row-cols-md-3 g-4">
    <!-- iterate through each object in model collection -->
    @foreach (var item in Model.Items)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                <div class="card-body">
                    <div class="d-flex justify-content-between mt-2">
                        <h5 class="text-start">
                            @item.Name
                            </h5>
                        <h5 class="text-nowrap">
                            @item.Price.ToString("0.00 NOK")
                            </h5>
                    </div>
                    <p class="card-text">@item.Description</p>
                </div>
            </div>
        </div>
    }
</section>